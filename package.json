{
  "name": "zotero-fulltext-flow",
  "version": "0.2.8",
  "private": true,
  "type": "module",
  "description": "Collection-scoped full-text completion for Zotero with configurable Zotero/JLSS retrieval strategies, PubMed identifier QA, remote-task diagnostics, cancellation controls, stable task-table UI, verification, and secure authentication.",
  "author": "FullTextFlow contributors",
  "license": "MIT",
  "homepage": "https://github.com/PracticeEarnestly/zotero-fulltext-flow",
  "repository": {
    "type": "git",
    "url": "https://github.com/PracticeEarnestly/zotero-fulltext-flow.git"
  },
  "config": {
    "addonName": "FullTextFlow for Zotero",
    "addonID": "fulltextflow@zotero.local",
    "addonRef": "fulltextflow",
    "addonInstance": "FullTextFlow",
    "prefsPrefix": "extensions.zotero.fullTextFlow"
  },
  "scripts": {
    "build": "zotero-plugin build",
    "typecheck": "tsc --noEmit",
    "build:local": "python3 scripts/build_local.py"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.8.2",
    "zotero-types": "^4.1.0-beta.4"
  }
}
